APP_NAME=AI Attendance System
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# Leave empty for local development (uses a local SQLite file).
# For Supabase/Neon, paste the PostgreSQL connection string here.
DATABASE_URL=
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-later
# Separate key that encrypts face templates. If you lose it, faces must be re-registered.
FACE_ENCRYPTION_KEY=
TIMEZONE=Asia/Kolkata
# Lower = stricter. 0.50 is a sensible start; tune with real testing.
FACE_MATCH_THRESHOLD=0.50
